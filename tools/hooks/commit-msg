#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""MiniDAQ's commit-msg hook (Chapter 36, ADR 0031), installed with the pre-commit hook:

    git config core.hooksPath tools/hooks

It checks the message being committed, and the author and committer git will record, against the
rules of tools/commit_policy.json that need no history: identity, subject, layout and review.
The rule reference needs the commit's changes and the change requests, and runs in CI
(tools/check_commits.py). `git commit --no-verify` skips the hook; CI does not.
"""
import json
import pathlib
import re
import subprocess
import sys

TOOLS = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(TOOLS))
import check_commits  # noqa: E402


def ident(var):
    out = subprocess.run(["git", "var", var], capture_output=True, text=True, check=True).stdout
    m = re.match(r"(.*) <(.*)>", out)
    return (m.group(1), m.group(2)) if m else ("", "")


def main(path):
    policy = json.loads((TOOLS / "commit_policy.json").read_text())
    text = pathlib.Path(path).read_text()
    # git strips the comment lines and the scissors' part after the hook; so does the check.
    text = text.split("# ------------------------ >8 ------------------------")[0]
    message = "\n".join(line for line in text.split("\n") if not line.startswith("#"))
    message = message.strip("\n") + "\n"
    commit = {"sha": "", "parents": ["HEAD"], "author": ident("GIT_AUTHOR_IDENT"),
              "committer": ident("GIT_COMMITTER_IDENT"), "message": message, "files": []}
    problems = []
    for rule in ("identity", "subject", "layout", "review"):
        problems += [f"{rule}: {p}" for p in getattr(check_commits, rule)(commit, policy)]
    for p in problems:
        print(f"commit-msg: {p}", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
