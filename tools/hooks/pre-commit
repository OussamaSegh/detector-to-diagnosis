#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""MiniDAQ's pre-commit hook (Chapter 32, ADR 0027). Install once per clone:

    git config core.hooksPath tools/hooks

It checks what is staged, in a second or two, and refuses the commit when a check fails:

1. whitespace errors and conflict markers (`git diff --cached --check`);
2. an e-mail address in an added line, other than a placeholder (example.com, example.org,
   example.invalid) or a no-reply address: the repository is public, and an address committed to
   it is published with its history;
3. the formatting of the staged C++ lines (tools/check_format.py --staged, rule 1.4);
4. ruff on the staged Python files of the analysis package (analysis/pyproject.toml).

A check whose tool is not installed is reported and skipped; CI runs checks 1, 3 and 4 on every
push, so a skipped check is found there. `git commit --no-verify` skips the hook; CI does not.
"""
import pathlib
import re
import shutil
import subprocess
import sys

TOOLS = pathlib.Path(__file__).resolve().parent.parent
ADDRESS = re.compile(r"[A-Za-z0-9._%+-]+@([A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,})")
ALLOWED_DOMAINS = ("example.com", "example.org", "example.invalid", "users.noreply.github.com")
ALLOWED_LOCAL = ("noreply@", "no-reply@")


def staged_diff():
    return subprocess.run(["git", "diff", "--cached", "-U0", "--no-color"], capture_output=True,
                          text=True, check=True).stdout


def addresses(diff):
    """(file, address) for every address in an added line that is not a placeholder."""
    found, current = [], None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            current = line[6:] if line.startswith("+++ b/") else line[4:]
        elif line.startswith("+") and not line.startswith("+++"):
            for m in ADDRESS.finditer(line):
                domain = m.group(1).lower()
                if domain.endswith(ALLOWED_DOMAINS) or m.group(0).lower().startswith(ALLOWED_LOCAL):
                    continue
                found.append((current, m.group(0)))
    return found


def staged_files(suffix, under=""):
    out = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
                         capture_output=True, text=True, check=True).stdout.split()
    return [f for f in out if f.endswith(suffix) and f.startswith(under)]


def main():
    failed = []
    r = subprocess.run(["git", "diff", "--cached", "--check"], capture_output=True, text=True)
    if r.returncode != 0:
        print(r.stdout, end="")
        failed.append("whitespace")
    for path, address in addresses(staged_diff()):
        print(f"{path}: adds the address {address}")
        failed.append("privacy")
    if shutil.which("clang-format") and shutil.which("git-clang-format"):
        if subprocess.run([sys.executable, str(TOOLS / "check_format.py"), "--staged"]).returncode:
            failed.append("format")
    else:
        print("pre-commit: clang-format not installed, formatting not checked")
    py = staged_files(".py", "analysis/")
    if py and shutil.which("ruff"):
        if subprocess.run(["ruff", "check", "--quiet", *py]).returncode:
            failed.append("ruff")
    elif py:
        print("pre-commit: ruff not installed, analysis/ not linted")
    if failed:
        print(f"pre-commit: refused ({', '.join(sorted(set(failed)))}); fix and stage again",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
