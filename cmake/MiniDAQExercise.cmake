# minidaq_exercise(<dir> [LIBS <targets>...] [NO_GTEST_MAIN])
# Builds <dir>/starter and/or <dir>/solution together with <dir>/tests.
# Files named bench_*.cpp in a variant directory become a separate Google
# Benchmark executable <target>_bench instead of being part of the test binary.
function(minidaq_exercise dir)
  cmake_parse_arguments(EX "NO_GTEST_MAIN" "" "LIBS" ${ARGN})
  get_filename_component(_abs ${dir} ABSOLUTE)
  get_filename_component(_name ${_abs} NAME)
  get_filename_component(_chdir ${_abs} DIRECTORY)
  get_filename_component(_ch ${_chdir} NAME)
  file(GLOB _tests CONFIGURE_DEPENDS ${_abs}/tests/*.cpp)

  set(_variants)
  if(MINIDAQ_BUILD_EXERCISES)
    list(APPEND _variants solution)
  endif()
  if(MINIDAQ_BUILD_STARTERS)
    list(APPEND _variants starter)
  endif()

  foreach(_v IN LISTS _variants)
    set(_t ${_ch}_${_name}_${_v})
    file(GLOB _srcs CONFIGURE_DEPENDS ${_abs}/${_v}/*.cpp)
    file(GLOB _bench CONFIGURE_DEPENDS ${_abs}/${_v}/bench_*.cpp)
    if(_bench)
      list(REMOVE_ITEM _srcs ${_bench})
      if(MINIDAQ_BUILD_BENCHMARKS)
        set(_lib_srcs ${_srcs})
        add_executable(${_t}_bench ${_bench} ${_lib_srcs})
        target_include_directories(${_t}_bench PRIVATE ${_abs}/${_v})
        target_link_libraries(${_t}_bench PRIVATE minidaq::core benchmark::benchmark_main ${EX_LIBS})
      endif()
    endif()
    add_executable(${_t} ${_srcs} ${_tests})
    target_include_directories(${_t} PRIVATE ${_abs}/${_v})
    if(_v STREQUAL "starter")
      # Starters intentionally contain unused parameters and TODO stubs.
      target_link_libraries(${_t} PRIVATE minidaq::core minidaq::warnings_no_error ${EX_LIBS})
    else()
      target_link_libraries(${_t} PRIVATE minidaq::core minidaq::warnings ${EX_LIBS})
    endif()
    if(EX_NO_GTEST_MAIN)
      target_link_libraries(${_t} PRIVATE GTest::gtest GTest::gmock)
    else()
      target_link_libraries(${_t} PRIVATE GTest::gtest_main GTest::gmock)
    endif()
    gtest_discover_tests(${_t}
      TEST_PREFIX "${_ch}/${_name}/${_v}/"
      PROPERTIES LABELS ${_v}
      DISCOVERY_TIMEOUT 30)
  endforeach()
endfunction()

# minidaq_python_exercise(<dir>)
# A Python exercise: <dir>/tests holds unittest tests that import the module
# from <dir>/starter or <dir>/solution (put on PYTHONPATH by the test).
function(minidaq_python_exercise dir)
  find_package(Python3 COMPONENTS Interpreter)
  if(NOT Python3_Interpreter_FOUND)
    message(STATUS "Python 3 not found: skipping ${dir}")
    return()
  endif()
  get_filename_component(_abs ${dir} ABSOLUTE)
  get_filename_component(_name ${_abs} NAME)
  get_filename_component(_chdir ${_abs} DIRECTORY)
  get_filename_component(_ch ${_chdir} NAME)
  set(_variants)
  if(MINIDAQ_BUILD_EXERCISES)
    list(APPEND _variants solution)
  endif()
  if(MINIDAQ_BUILD_STARTERS)
    list(APPEND _variants starter)
  endif()
  foreach(_v IN LISTS _variants)
    add_test(NAME ${_ch}/${_name}/${_v}/unittest
             COMMAND ${Python3_EXECUTABLE} -m unittest discover -s ${_abs}/tests -t ${_abs}/tests)
    set_tests_properties(${_ch}/${_name}/${_v}/unittest PROPERTIES
      LABELS ${_v}
      ENVIRONMENT "PYTHONPATH=${_abs}/${_v};PYTHONDONTWRITEBYTECODE=1")
  endforeach()
endfunction()

# minidaq_mutation_exercise(<dir> MUTANTS <n> [MIN_TESTS <m>])
# An exercise whose deliverable is tests (Chapter 18). The *.cpp files of a
# variant are tests of the subject in <dir>/tests/subject.hpp, built n+1 times:
# against the subject (EX_MUTANT=0), where they must pass, and against each of
# its seeded mistakes (EX_MUTANT=1..n), where they must fail. A mutant that the
# tests pass is a mistake they would let through. MIN_TESTS also requires at
# least <m> test cases.
function(minidaq_mutation_exercise dir)
  cmake_parse_arguments(EX "" "MUTANTS;MIN_TESTS" "" ${ARGN})
  get_filename_component(_abs ${dir} ABSOLUTE)
  get_filename_component(_name ${_abs} NAME)
  get_filename_component(_chdir ${_abs} DIRECTORY)
  get_filename_component(_ch ${_chdir} NAME)
  set(_variants)
  if(MINIDAQ_BUILD_EXERCISES)
    list(APPEND _variants solution)
  endif()
  if(MINIDAQ_BUILD_STARTERS)
    list(APPEND _variants starter)
  endif()
  foreach(_v IN LISTS _variants)
    file(GLOB _srcs CONFIGURE_DEPENDS ${_abs}/${_v}/*.cpp)
    foreach(_m RANGE 0 ${EX_MUTANTS})
      set(_t ${_ch}_${_name}_${_v}_m${_m})
      add_executable(${_t} ${_srcs})
      target_include_directories(${_t} PRIVATE ${_abs}/tests ${PROJECT_SOURCE_DIR}/minidaq/tests)
      target_compile_definitions(${_t} PRIVATE EX_MUTANT=${_m})
      if(_v STREQUAL "starter")
        target_link_libraries(${_t} PRIVATE minidaq::core minidaq::warnings_no_error GTest::gtest_main)
      else()
        target_link_libraries(${_t} PRIVATE minidaq::core minidaq::warnings GTest::gtest_main)
      endif()
      if(_m EQUAL 0)
        set(_test ${_ch}/${_name}/${_v}/original)
        add_test(NAME ${_test} COMMAND ${_t})
        if(EX_MIN_TESTS)
          add_test(NAME ${_ch}/${_name}/${_v}/at_least_${EX_MIN_TESTS}_tests
                   COMMAND ${CMAKE_COMMAND} -DEXE=$<TARGET_FILE:${_t}> -DMIN=${EX_MIN_TESTS}
                           -P ${PROJECT_SOURCE_DIR}/cmake/CountTests.cmake)
          set_tests_properties(${_ch}/${_name}/${_v}/at_least_${EX_MIN_TESTS}_tests PROPERTIES LABELS ${_v})
        endif()
      else()
        set(_test ${_ch}/${_name}/${_v}/mutant_${_m})
        add_test(NAME ${_test} COMMAND ${_t})
        set_tests_properties(${_test} PROPERTIES WILL_FAIL TRUE)  # the tests must catch the mutant
      endif()
      set_tests_properties(${_test} PROPERTIES LABELS ${_v} TIMEOUT 60)
    endforeach()
  endforeach()
endfunction()
