# The CMake package of MiniDAQ's projector library (Chapter 32):
#   find_package(recon 0.7 REQUIRED)
#   target_link_libraries(app PRIVATE recon::projector)
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# recon::projector links Threads::Threads publicly: whoever uses it must be able to find it.
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/reconTargets.cmake")
check_required_components(recon)
