+// SPDX-License-Identifier: MIT
+#include <gtest/gtest.h>
+
+#include <chrono>
+#include <thread>
+
+#include "minidaq/control/rate_meter.hpp"
+
+using namespace minidaq::control;
+
+TEST(RateMeter, CountsPackets) {
+  RateMeter m;
+  m.add(1, 100);
+  std::this_thread::sleep_for(std::chrono::seconds(1));
+  m.add(2, 100);
+  EXPECT_GT(m.rate(), 0.0);
+}
